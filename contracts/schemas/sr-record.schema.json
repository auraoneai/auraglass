{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "sr-record.schema.json",
 "$comment": "contract-v1.2 C-16: the single SrRecord schema (src/contracts/fragments.ts SrRecord). MAT verify-a11y-manual.mjs and the QUAL aggregator both read this file. REQ-FIN-110 (additive): the optional L13 binding fields stream, pass and storybookArtifactUrl, the step narrative fields action/expected/announced, the device touch ATs and a numeric (or null) flagship; the verifier's L13 profile makes them required for records under tests/a11y/manual/records/.",
 "title": "SrRecord",
 "description": "REQ-FIN-110 / Appendix C C-16 unified field set. One manual screen-reader, touch or reduced-motion pass of one subject on one AT, bound to the SHA whose CI-built Storybook artifact was tested. Written by human testers only (issue #16).",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "sha",
  "subject",
  "flagship",
  "stream",
  "pass",
  "at",
  "atVersion",
  "browser",
  "browserVersion",
  "os",
  "osVersion",
  "tester",
  "date",
  "result",
  "steps",
  "storybookArtifactUrl"
 ],
 "properties": {
  "sha": {
   "type": "string",
   "pattern": "^[0-9a-f]{7,40}$"
  },
  "subject": {
   "type": "string",
   "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "flagship": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 1
  },
  "stream": {
   "type": "string",
   "enum": [
    "mat",
    "cmp",
    "surf"
   ]
  },
  "pass": {
   "type": "string",
   "enum": [
    "sr",
    "touch",
    "motion"
   ]
  },
  "at": {
   "type": "string",
   "enum": [
    "voiceover-macos",
    "voiceover-ios",
    "nvda-chrome",
    "talkback-chrome",
    "touch",
    "touch-ios",
    "touch-android"
   ]
  },
  "atVersion": {
   "type": "string",
   "minLength": 1
  },
  "browser": {
   "type": "string",
   "minLength": 1
  },
  "browserVersion": {
   "type": "string",
   "minLength": 1
  },
  "os": {
   "type": "string",
   "minLength": 1
  },
  "osVersion": {
   "type": "string",
   "minLength": 1
  },
  "device": {
   "type": "string",
   "minLength": 1
  },
  "tester": {
   "type": "string",
   "minLength": 1
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "result": {
   "type": "string",
   "enum": [
    "pass",
    "fail"
   ]
  },
  "steps": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "action",
     "expected",
     "announced",
     "pass"
    ],
    "properties": {
     "action": {
      "type": "string",
      "minLength": 1
     },
     "expected": {
      "type": "string",
      "minLength": 1
     },
     "announced": {
      "type": "string"
     },
     "nameRoleValue": {
      "type": "string"
     },
     "stateChange": {
      "type": "string"
     },
     "openClose": {
      "type": "string"
     },
     "liveRegion": {
      "type": "string"
     },
     "gesture": {
      "type": "string",
      "minLength": 1
     },
     "nonDragAlternative": {
      "type": "string",
      "minLength": 1
     },
     "pass": {
      "type": "boolean"
     },
     "notes": {
      "type": "string"
     }
    }
   }
  },
  "storybookArtifactUrl": {
   "type": "string",
   "pattern": "^https://"
  },
  "notes": {
   "type": "string"
  }
 },
 "allOf": [
  {
   "if": {
    "anyOf": [
     {
      "required": [
       "pass"
      ],
      "properties": {
       "pass": {
        "const": "touch"
       }
      }
     },
     {
      "required": [
       "at"
      ],
      "properties": {
       "at": {
        "enum": [
         "voiceover-ios",
         "talkback-chrome",
         "touch-ios",
         "touch-android"
        ]
       }
      }
     }
    ]
   },
   "then": {
    "required": [
     "device"
    ]
   }
  },
  {
   "if": {
    "required": [
     "pass"
    ],
    "properties": {
     "pass": {
      "const": "touch"
     }
    }
   },
   "then": {
    "properties": {
     "at": {
      "enum": [
       "touch-ios",
       "touch-android"
      ]
     },
     "steps": {
      "items": {
       "required": [
        "gesture",
        "nonDragAlternative"
       ]
      }
     }
    }
   }
  },
  {
   "if": {
    "required": [
     "at"
    ],
    "properties": {
     "at": {
      "enum": [
       "touch-ios",
       "touch-android"
      ]
     }
    }
   },
   "then": {
    "properties": {
     "pass": {
      "const": "touch"
     }
    }
   }
  }
 ]
}
