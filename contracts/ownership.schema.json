{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ownership.schema.json",
 "type": "object",
 "required": [
  "version",
  "rows"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "version": {
   "const": 1
  },
  "rows": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "glob",
     "owner"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "glob": {
      "type": "string"
     },
     "owner": {
      "enum": [
       "PLAT",
       "MAT",
       "CMP",
       "SURF",
       "QUAL",
       "CONTRACT",
       "NONE"
      ]
     },
     "note": {
      "type": "string"
     },
     "lines": {
      "type": "array",
      "items": {
       "enum": [
        "4x",
        "5x"
       ]
      }
     }
    },
    "additionalProperties": false
   }
  },
  "branchRules": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "prefix",
     "rule"
    ],
    "additionalProperties": false,
    "properties": {
     "prefix": {
      "type": "string"
     },
     "line": {
      "enum": [
       "4x",
       "5x"
      ]
     },
     "rule": {
      "enum": [
       "stream",
       "4x-zone",
       "fin-wp",
       "any-owned",
       "sync",
       "report-only",
       "fail-closed"
      ]
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 },
 "additionalProperties": false
}
