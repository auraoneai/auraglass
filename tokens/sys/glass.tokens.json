{
  "$schema": "../$schema.json",
  "sys": {
    "$extensions": { "ag.tier": "sys", "ag.since": "5.0.0" },
    "$description": "sys-tier material inputs: the only names material.* may alias (MAT-007 guard). Non-public; they feed the ladder generator and thickness cells.",
    "blur": {
      "$type": "dimension",
      "thin":    { "$value": "{ref.dimension.blur.thin}" },
      "regular": { "$value": "{ref.dimension.blur.regular}" },
      "thick":   { "$value": "{ref.dimension.blur.thick}" }
    },
    "rim": {
      "$type": "dimension",
      "thin":    { "$value": "{ref.dimension.rim.thin}" },
      "regular": { "$value": "{ref.dimension.rim.regular}" },
      "thick":   { "$value": "{ref.dimension.rim.thick}" }
    },
    "bezel": {
      "$type": "dimension",
      "thin":    { "$value": "{ref.dimension.bezel.thin}" },
      "regular": { "$value": "{ref.dimension.bezel.regular}" },
      "thick":   { "$value": "{ref.dimension.bezel.thick}" }
    },
    "shadow": {
      "$type": "shadow",
      "thin":    { "$value": { "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 4, "unit": "px" },  "spread": { "value": 0, "unit": "px" }, "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.10 } } },
      "regular": { "$value": { "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 16, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.14 } } },
      "thick":   { "$value": { "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 32, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.20 } } }
    },
    "optics": {
      "saturation": { "$type": "number", "$value": 1.6 },
      "lightAngle": { "$type": "dimension", "$value": { "value": 300, "unit": "deg" } }
    }
  }
}
