{
  "$schema": "../$schema.json",
  "sys": {
    "$extensions": {
      "ag.tier": "sys",
      "ag.since": "5.0.0"
    },
    "space": {
      "$description": "4pt grid; emitted as calc(<px> * var(--_ag-density)) so density scales at runtime (MAT-015).",
      "0": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-0",
          "ag.calc": "density"
        }
      },
      "1": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-1",
          "ag.calc": "density"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-2",
          "ag.calc": "density"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-3",
          "ag.calc": "density"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-4",
          "ag.calc": "density"
        }
      },
      "5": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-5",
          "ag.calc": "density"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-6",
          "ag.calc": "density"
        }
      },
      "8": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-8",
          "ag.calc": "density"
        }
      },
      "10": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-10",
          "ag.calc": "density"
        }
      },
      "12": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-12",
          "ag.calc": "density"
        }
      },
      "16": {
        "$type": "dimension",
        "$value": {
          "value": 64,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-space-16",
          "ag.calc": "density"
        }
      }
    },
    "density": {
      "factor": {
        "$type": "mode-table",
        "$value": {
          "regular": 1,
          "compact": 0.875,
          "spacious": 1.125
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": false,
          "ag.cssVar": "--_ag-density",
          "ag.axis": "density",
          "ag.valueType": "number"
        }
      },
      "readout": {
        "$type": "string",
        "$value": "var(--_ag-density)",
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-density"
        }
      }
    },
    "target": {
      "$description": "Hit-target sizes; NOT density-scaled (MAT-015).",
      "min": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-target-min"
        }
      },
      "coarse": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-target-coarse"
        }
      }
    },
    "shape": {
      "radius-outer": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-radius-outer"
        }
      },
      "inset": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-inset"
        }
      },
      "radius-inner": {
        "$type": "string",
        "$value": "max(0px, calc(var(--ag-radius-outer) - var(--ag-inset)))",
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-radius-inner"
        }
      }
    },
    "layout": {
      "scroll-padding-top": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-scroll-padding-top"
        }
      },
      "scroll-padding-bottom": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "sys",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-scroll-padding-bottom"
        }
      }
    }
  }
}
