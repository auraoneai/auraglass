{
  "$schema": "../$schema.json",
  "sys": {
    "$extensions": { "ag.tier": "sys", "ag.since": "5.0.0" },
    "type": {
      "$description": "Type roles (REQ-MAT-09). Fluid roles emit clamp() between their min/max ref endpoints over a 360-1280px viewport; weight is a unitless number.",
      "display": {
        "size":    { "$type": "dimension", "$value": { "min": { "value": 32, "unit": "px" }, "max": { "value": 44, "unit": "px" } }, "$extensions": { "ag.public": true, "ag.fluid": true, "ag.cssVar": "--ag-type-display-size" } },
        "leading": { "$type": "number", "$value": 1.1, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-display-leading" } },
        "weight":  { "$type": "fontWeight", "$value": 650, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-display-weight" } }
      },
      "title-1": {
        "size":    { "$type": "dimension", "$value": { "min": { "value": 26, "unit": "px" }, "max": { "value": 32, "unit": "px" } }, "$extensions": { "ag.public": true, "ag.fluid": true, "ag.cssVar": "--ag-type-title-1-size" } },
        "leading": { "$type": "number", "$value": 1.15, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-title-1-leading" } },
        "weight":  { "$type": "fontWeight", "$value": 620, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-title-1-weight" } }
      },
      "title-2": {
        "size":    { "$type": "dimension", "$value": { "min": { "value": 22, "unit": "px" }, "max": { "value": 26, "unit": "px" } }, "$extensions": { "ag.public": true, "ag.fluid": true, "ag.cssVar": "--ag-type-title-2-size" } },
        "leading": { "$type": "number", "$value": 1.2, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-title-2-leading" } },
        "weight":  { "$type": "fontWeight", "$value": 600, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-title-2-weight" } }
      },
      "title-3": {
        "size":    { "$type": "dimension", "$value": { "min": { "value": 19, "unit": "px" }, "max": { "value": 21, "unit": "px" } }, "$extensions": { "ag.public": true, "ag.fluid": true, "ag.cssVar": "--ag-type-title-3-size" } },
        "leading": { "$type": "number", "$value": 1.25, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-title-3-leading" } },
        "weight":  { "$type": "fontWeight", "$value": 560, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-title-3-weight" } }
      },
      "body": {
        "size":    { "$type": "dimension", "$value": { "value": 15, "unit": "px" }, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-body-size" } },
        "leading": { "$type": "number", "$value": 1.5, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-body-leading" } },
        "weight":  { "$type": "fontWeight", "$value": 400, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-body-weight" } }
      },
      "callout": {
        "size":    { "$type": "dimension", "$value": { "min": { "value": 14, "unit": "px" }, "max": { "value": 16, "unit": "px" } }, "$extensions": { "ag.public": true, "ag.fluid": true, "ag.cssVar": "--ag-type-callout-size" } },
        "leading": { "$type": "number", "$value": 1.4, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-callout-leading" } },
        "weight":  { "$type": "fontWeight", "$value": 450, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-callout-weight" } }
      },
      "caption": {
        "size":    { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-caption-size" } },
        "leading": { "$type": "number", "$value": 1.35, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-caption-leading" } },
        "weight":  { "$type": "fontWeight", "$value": 400, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-caption-weight" } }
      },
      "label": {
        "size":    { "$type": "dimension", "$value": { "value": 13, "unit": "px" }, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-label-size" } },
        "leading": { "$type": "number", "$value": 1.3, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-label-leading" } },
        "weight":  { "$type": "fontWeight", "$value": 500, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-label-weight" } }
      },
      "mono": {
        "size":    { "$type": "dimension", "$value": { "value": 14, "unit": "px" }, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-mono-size" } },
        "leading": { "$type": "number", "$value": 1.45, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-mono-leading" } },
        "weight":  { "$type": "fontWeight", "$value": 450, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-type-mono-weight" } }
      }
    },
    "font": {
      "sans": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif", "$extensions": { "ag.public": true, "ag.cssVar": "--ag-font-sans" } },
      "mono": { "$type": "fontFamily", "$value": "'SF Mono', ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace", "$extensions": { "ag.public": true, "ag.cssVar": "--ag-font-mono" } }
    },
    "target": {
      "min":    { "$type": "dimension", "$value": { "value": 24, "unit": "px" }, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-target-min" } },
      "coarse": { "$type": "dimension", "$value": { "value": 44, "unit": "px" }, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-target-coarse" } }
    },
    "z": {
      "$type": "number",
      "content":   { "$value": 0,    "$extensions": { "ag.public": true, "ag.cssVar": "--ag-z-content" } },
      "chrome":   { "$value": 100,  "$extensions": { "ag.public": true, "ag.cssVar": "--ag-z-chrome" } },
      "overlay":  { "$value": 1000, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-z-overlay" } },
      "transient":{ "$value": 1100, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-z-transient" } },
      "toast":    { "$value": 1200, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-z-toast" } }
    },
    "scrim": {
      "clear": { "$type": "number", "$value": 0.35, "$description": "Alpha of the clear scrim (REQ-MAT values).", "$extensions": { "ag.public": true, "ag.cssVar": "--ag-scrim-clear" } },
      "media": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.72 }, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-scrim-media" } }
    },
    "focus": {
      "inner": { "$type": "color", "$value": "{sys.color.focus-inner}", "$extensions": { "ag.public": true, "ag.cssVar": "--ag-focus-inner" } },
      "outer": { "$type": "color", "$value": "{sys.color.focus-outer}", "$extensions": { "ag.public": true, "ag.cssVar": "--ag-focus-outer" } },
      "width": { "$type": "dimension", "$value": { "value": 2, "unit": "px" }, "$extensions": { "ag.public": true, "ag.cssVar": "--ag-focus-width" } }
    }
  }
}
