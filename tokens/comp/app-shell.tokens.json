{
  "$schema": "../$schema.json",
  "comp": {
    "$extensions": {
      "ag.tier": "comp",
      "ag.since": "5.0.0"
    },
    "app-shell": {
      "$description": "App-shell metrics (OD-19: moved from sys; private --_ag-app-shell-* per contract §4.2). The compact/expanded/wide breakpoints (600/1024/1440px, MAT-083: read-only, non-functional) are not tokens: a custom property cannot drive a @container query, so they live only as the literal conditions in src/app-shell/app-shell.css.",
      "sidebar-width": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "rem"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": false,
          "ag.cssVar": "--_ag-app-shell-sidebar-width",
          "ag.requestedBy": "MAT-083"
        }
      },
      "rail-width": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "rem"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": false,
          "ag.cssVar": "--_ag-app-shell-rail-width",
          "ag.requestedBy": "MAT-083"
        }
      },
      "inspector-width": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "rem"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": false,
          "ag.cssVar": "--_ag-app-shell-inspector-width",
          "ag.requestedBy": "MAT-083"
        }
      },
      "topbar-height": {
        "$type": "mode-table",
        "$value": {
          "default": {
            "value": 3.25,
            "unit": "rem"
          },
          "density.compact": {
            "value": 2.75,
            "unit": "rem"
          }
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": false,
          "ag.cssVar": "--_ag-app-shell-topbar-height",
          "ag.valueType": "dimension",
          "ag.requestedBy": "MAT-083"
        }
      },
      "tabbar-height": {
        "$type": "dimension",
        "$value": {
          "value": 3.5,
          "unit": "rem"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": false,
          "ag.cssVar": "--_ag-app-shell-tabbar-height",
          "ag.requestedBy": "MAT-083"
        }
      },
      "gap": {
        "$type": "mode-table",
        "$value": {
          "default": "{sys.space.4}",
          "density.compact": "{sys.space.2}",
          "density.spacious": "{sys.space.6}"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": false,
          "ag.cssVar": "--_ag-app-shell-gap",
          "ag.valueType": "dimension",
          "ag.requestedBy": "MAT-083"
        }
      }
    }
  }
}
