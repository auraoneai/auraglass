{
  "$schema": "../$schema.json",
  "comp": {
    "$extensions": { "ag.tier": "comp", "ag.since": "5.0.0" },
    "$description": "Component-tier defaults. Comp vars are private (--_ag-comp-*) except the few promoted to public readouts.",
    "control": {
      "height":       { "$type": "dimension", "$value": "{sys.target.min}", "$extensions": { "ag.public": false } },
      "height-coarse":{ "$type": "dimension", "$value": "{sys.target.coarse}", "$extensions": { "ag.public": false } },
      "padding-x":    { "$type": "dimension", "$value": "{ref.dimension.space.3}", "$extensions": { "ag.public": false } },
      "gap":          { "$type": "dimension", "$value": "{ref.dimension.space.2}", "$extensions": { "ag.public": false } },
      "radius":       { "$type": "dimension", "$value": "{ref.dimension.radius.md}", "$extensions": { "ag.public": false } }
    },
    "panel": {
      "padding": { "$type": "dimension", "$value": "{ref.dimension.space.4}", "$extensions": { "ag.public": false } },
      "radius":  { "$type": "dimension", "$value": "{ref.dimension.radius.lg}", "$extensions": { "ag.public": false } },
      "thickness": { "$type": "string", "$value": "regular", "$extensions": { "ag.public": false } }
    },
    "text": {
      "large-min": { "$type": "dimension", "$value": { "value": 24, "unit": "px" }, "$description": ">= 24px is 'large text' for the 3:1 contrast tier.", "$extensions": { "ag.public": false } }
    }
  }
}
