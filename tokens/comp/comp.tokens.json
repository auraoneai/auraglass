{
  "$schema": "../$schema.json",
  "comp": {
    "$extensions": {
      "ag.tier": "comp",
      "ag.since": "5.0.0"
    },
    "$description": "Component-tier defaults. Comp vars are private (--_ag-comp-*) except the few promoted to public readouts.",
    "control": {
      "height": {
        "$type": "dimension",
        "$value": "{sys.target.min}",
        "$extensions": {
          "ag.public": false
        }
      },
      "height-coarse": {
        "$type": "dimension",
        "$value": "{sys.target.coarse}",
        "$extensions": {
          "ag.public": false
        }
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{sys.space.3}",
        "$extensions": {
          "ag.public": false
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{sys.space.2}",
        "$extensions": {
          "ag.public": false
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$extensions": {
          "ag.public": false
        }
      }
    },
    "panel": {
      "padding": {
        "$type": "dimension",
        "$value": "{sys.space.4}",
        "$extensions": {
          "ag.public": false
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$extensions": {
          "ag.public": false
        }
      },
      "thickness": {
        "$type": "string",
        "$value": "regular",
        "$extensions": {
          "ag.public": false
        }
      }
    },
    "text": {
      "large-min": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": ">= 24px is 'large text' for the 3:1 contrast tier.",
        "$extensions": {
          "ag.public": false
        }
      }
    }
  }
}
