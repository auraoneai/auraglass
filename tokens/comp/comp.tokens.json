{
  "$schema": "../$schema.json",
  "comp": {
    "$extensions": {
      "ag.tier": "comp",
      "ag.since": "5.0.0"
    },
    "$description": "Component-tier defaults. Comp vars are private (--_ag-comp-*) except the few promoted to public readouts.",
    "control": {
      "height": {
        "$type": "dimension",
        "$value": "{sys.target.min}",
        "$extensions": {
          "ag.public": false
        }
      },
      "height-coarse": {
        "$type": "dimension",
        "$value": "{sys.target.coarse}",
        "$extensions": {
          "ag.public": false
        }
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{sys.space.3}",
        "$extensions": {
          "ag.public": false
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{sys.space.2}",
        "$extensions": {
          "ag.public": false
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$extensions": {
          "ag.public": false
        }
      },
      "height-vars": {
        "$description": "Promoted public control-height readouts (MAT-003): per size x density override hooks.",
        "$type": "dimension",
        "$value": {
          "value": 36,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": false
        }
      }
    },
    "panel": {
      "padding": {
        "$type": "dimension",
        "$value": "{sys.space.4}",
        "$extensions": {
          "ag.public": false
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$extensions": {
          "ag.public": false
        }
      },
      "thickness": {
        "$type": "string",
        "$value": "regular",
        "$extensions": {
          "ag.public": false
        }
      }
    },
    "text": {
      "large-min": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": ">= 24px is 'large text' for the 3:1 contrast tier.",
        "$extensions": {
          "ag.public": false
        }
      }
    },
    "readout": {
      "$description": "REQ-FIN-11 / contract C-7 PUBLIC_CSS_VARS.comp: control heights per size x density (CMP PRD size row: compact 24/32/44, default 28/36/44, spacious 32/40/48 for sm/md/lg).",
      "sm-compact": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-comp-control-height-sm-compact"
        }
      },
      "sm-default": {
        "$type": "dimension",
        "$value": {
          "value": 28,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-comp-control-height-sm-default"
        }
      },
      "sm-spacious": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-comp-control-height-sm-spacious"
        }
      },
      "md-compact": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-comp-control-height-md-compact"
        }
      },
      "md-default": {
        "$type": "dimension",
        "$value": {
          "value": 36,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-comp-control-height-md-default"
        }
      },
      "md-spacious": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-comp-control-height-md-spacious"
        }
      },
      "lg-compact": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-comp-control-height-lg-compact"
        }
      },
      "lg-default": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-comp-control-height-lg-default"
        }
      },
      "lg-spacious": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-comp-control-height-lg-spacious"
        }
      }
    },
    "switch": {
      "$description": "REQ-FIN-11 / REQ-CMP-45 switch track geometry (contract C-7 PUBLIC_CSS_VARS.switchTrack); thumb inset is private.",
      "track-w-sm": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-switch-track-w-sm"
        }
      },
      "track-w-md": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-switch-track-w-md"
        }
      },
      "track-w-lg": {
        "$type": "dimension",
        "$value": {
          "value": 52,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-switch-track-w-lg"
        }
      },
      "track-h-sm": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-switch-track-h-sm"
        }
      },
      "track-h-md": {
        "$type": "dimension",
        "$value": {
          "value": 22,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-switch-track-h-md"
        }
      },
      "track-h-lg": {
        "$type": "dimension",
        "$value": {
          "value": 30,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": true,
          "ag.cssVar": "--ag-switch-track-h-lg"
        }
      },
      "thumb-inset": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$extensions": {
          "ag.tier": "comp",
          "ag.since": "5.0.0",
          "ag.public": false,
          "ag.cssVar": "--_ag-switch-thumb-inset"
        }
      }
    }
  }
}
