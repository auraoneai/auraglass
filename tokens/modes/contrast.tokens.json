{
  "$schema": "../$schema.json",
  "mode": {
    "$extensions": {
      "ag.tier": "sys",
      "ag.since": "5.0.0"
    },
    "contrast": {
      "$type": "mode-table",
      "$extensions": {
        "ag.axisDef": "contrast"
      },
      "$value": {
        "default": "standard",
        "values": [
          "standard",
          "more"
        ],
        "selectors": {
          "more": [
            "[data-ag-contrast=\"more\"]",
            "@media (prefers-contrast: more)"
          ]
        }
      }
    }
  }
}
