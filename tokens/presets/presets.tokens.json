{
  "$schema": "../$schema.json",
  "preset": {
    "$extensions": { "ag.tier": "sys", "ag.since": "5.0.0" },
    "$description": "Theme presets (REQ-MAT-33): 4 presets; radiusScale applies to the radius ladder; canvas/accent drive the sys color overrides the compiler emits under [data-ag-theme=<id>].",
    "aura": {
      "$type": "theme-preset",
      "$value": {
        "name": "Aura",
        "canvas": {
          "light": { "colorSpace": "oklch", "components": [0.99, 0.004, 250], "alpha": 1 },
          "dark": { "colorSpace": "oklch", "components": [0.18, 0.012, 250], "alpha": 1 }
        },
        "neutralHue": 250,
        "accent": { "colorSpace": "oklch", "components": [0.64, 0.16, 235], "alpha": 1 },
        "radiusScale": 1
      }
    },
    "graphite": {
      "$type": "theme-preset",
      "$value": {
        "name": "Graphite",
        "canvas": {
          "light": { "colorSpace": "oklch", "components": [0.97, 0.003, 240], "alpha": 1 },
          "dark": { "colorSpace": "oklch", "components": [0.22, 0.008, 240], "alpha": 1 }
        },
        "neutralHue": 240,
        "accent": { "colorSpace": "oklch", "components": [0.55, 0.02, 240], "alpha": 1 },
        "radiusScale": 0.75
      }
    },
    "daylight": {
      "$type": "theme-preset",
      "$value": {
        "name": "Daylight",
        "canvas": {
          "light": { "colorSpace": "oklch", "components": [0.995, 0.002, 95], "alpha": 1 },
          "dark": { "colorSpace": "oklch", "components": [0.25, 0.01, 95], "alpha": 1 }
        },
        "neutralHue": 95,
        "accent": { "colorSpace": "oklch", "components": [0.62, 0.17, 150], "alpha": 1 },
        "radiusScale": 1
      }
    },
    "midnight": {
      "$type": "theme-preset",
      "$value": {
        "name": "Midnight",
        "canvas": {
          "light": { "colorSpace": "oklch", "components": [0.96, 0.01, 270], "alpha": 1 },
          "dark": { "colorSpace": "oklch", "components": [0.16, 0.02, 270], "alpha": 1 }
        },
        "neutralHue": 270,
        "accent": { "colorSpace": "oklch", "components": [0.60, 0.18, 290], "alpha": 1 },
        "radiusScale": 1.25
      }
    }
  }
}
