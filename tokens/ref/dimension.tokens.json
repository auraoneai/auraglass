{
  "$schema": "../$schema.json",
  "ref": {
    "$extensions": { "ag.tier": "ref", "ag.since": "5.0.0" },
    "dimension": {
      "$description": "Base dimension ladder (REQ-MAT-06/07): 4pt space base, radius ladder, blur ladder (cap 32px), type sizes, target sizes, bezel widths.",
      "space": {
        "0":  { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "05": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
        "1":  { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "15": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "2":  { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "3":  { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "4":  { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "5":  { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "6":  { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "8":  { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
        "10": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
        "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
        "16": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } }
      },
      "radius": {
        "xs":   { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "sm":   { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
        "md":   { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "lg":   { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "xl":   { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
        "full": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" } }
      },
      "blur": {
        "$description": "The only blur ladder in the library; no blur token exceeds 32px (REQ-MAT-02 guard).",
        "thin":    { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "regular": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "thick":   { "$type": "dimension", "$value": { "value": 32, "unit": "px" } }
      },
      "target": {
        "min":    { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "coarse": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } }
      },
      "focusWidth": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
      "rim": {
        "thin":    { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
        "regular": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
        "thick":   { "$type": "dimension", "$value": { "value": 1.5, "unit": "px" } }
      },
      "bezel": {
        "thin":    { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "regular": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "thick":   { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
      },
      "scrollPadding": {
        "top":    { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "bottom": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "type": {
        "$description": "Type size floor/cap endpoints for the fluid roles (px).",
        "display": { "min": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } }, "max": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } } },
        "title1":  { "min": { "$type": "dimension", "$value": { "value": 26, "unit": "px" } }, "max": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } } },
        "title2":  { "min": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } }, "max": { "$type": "dimension", "$value": { "value": 26, "unit": "px" } } },
        "title3":  { "min": { "$type": "dimension", "$value": { "value": 19, "unit": "px" } }, "max": { "$type": "dimension", "$value": { "value": 21, "unit": "px" } } },
        "callout": { "min": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }, "max": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } } },
        "caption": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "label":   { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "mono":    { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      }
    }
  }
}
