{
  "$schema": "../$schema.json",
  "ref": {
    "$extensions": { "ag.tier": "ref", "ag.since": "5.0.0" },
    "time": {
      "$description": "Motion reference values (REQ-MAT-08; archived MOT §4.2). sys/motion.tokens.json aliases these; nothing else may author durations/eases/springs.",
      "duration": {
        "instant": { "$type": "duration", "$value": { "value": 90, "unit": "ms" } },
        "instant-exit": { "$type": "duration", "$value": { "value": 60, "unit": "ms" } },
        "micro": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
        "micro-exit": { "$type": "duration", "$value": { "value": 80, "unit": "ms" } },
        "small": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
        "small-exit": { "$type": "duration", "$value": { "value": 140, "unit": "ms" } },
        "medium": { "$type": "duration", "$value": { "value": 320, "unit": "ms" } },
        "medium-exit": { "$type": "duration", "$value": { "value": 220, "unit": "ms" } },
        "large": { "$type": "duration", "$value": { "value": 450, "unit": "ms" } },
        "large-exit": { "$type": "duration", "$value": { "value": 320, "unit": "ms" } },
        "ambient": { "$type": "duration", "$value": { "value": 40000, "unit": "ms" } }
      },
      "ease": {
        "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
        "emphasized": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
        "emphasized-decelerate": { "$type": "cubicBezier", "$value": [0.05, 0.7, 0.1, 1] },
        "accelerate": { "$type": "cubicBezier", "$value": [0.3, 0, 1, 1] }
      },
      "spring": {
        "snappy": { "$type": "motion-spring", "$value": { "dampingRatio": 1.0, "response": { "value": 200, "unit": "ms" } } },
        "smooth": { "$type": "motion-spring", "$value": { "dampingRatio": 0.9, "response": { "value": 350, "unit": "ms" } } },
        "fluid": { "$type": "motion-spring", "$value": { "dampingRatio": 0.82, "response": { "value": 450, "unit": "ms" } } }
      }
    }
  }
}
