{
  "name": "aura-glass",
  "version": "5.0.0-alpha.0",
  "description": "AuraGlass 5.0 — the liquid-glass design system for React 19.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auraoneai/auraglass.git"
  },
  "bugs": {
    "url": "https://github.com/auraoneai/auraglass/issues"
  },
  "homepage": "https://auraglass.auraone.ai",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "files": [
    "dist",
    "deprecations.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js",
      "css": "./dist/styles.css"
    },
    "./material": {
      "types": "./dist/material/index.d.ts",
      "default": "./dist/material/index.js",
      "css": "./dist/material.css"
    },
    "./theme": {
      "types": "./dist/theme/public.d.ts",
      "default": "./dist/theme/public.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js",
      "css": "./dist/tokens.css"
    },
    "./motion": {
      "types": "./dist/motion/public.d.ts",
      "default": "./dist/motion/public.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./app-shell": {
      "types": "./dist/app-shell/index.d.ts",
      "default": "./dist/app-shell/index.js",
      "css": "./dist/app-shell.css"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js",
      "css": "./dist/data.css"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "default": "./dist/date/index.js",
      "css": "./dist/date.css"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js",
      "css": "./dist/ai.css"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js",
      "css": "./dist/media.css"
    },
    "./backdrops": {
      "types": "./dist/backdrops/index.d.ts",
      "default": "./dist/backdrops/index.js",
      "css": "./dist/backdrops.css"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "default": "./dist/compat/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./material.css": "./dist/material.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./compat/tokens.css": "./dist/compat/tokens.css",
    "./compat/globals.css": "./dist/compat/globals.css",
    "./deprecations.json": "./deprecations.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tokens:build": "node scripts/tokens/build.mjs",
    "build": "npm run tokens:build && tsdown",
    "api:update": "node scripts/build/api-report.mjs",
    "pack:verify": "node scripts/ci/verify-pack.js",
    "storybook:build": "storybook build -o storybook-static",
    "docs:build": "npm run build -w apps/docs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:contract": "npm test -- tests/contract",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "clsx": "2.1.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-aria-components": "^1.21.1",
    "@internationalized/date": "^3.12.4",
    "motion": "^12.0.0",
    "react-hook-form": "^7.0.0",
    "three": ">=0.170.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/drei": "^10.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-aria-components": { "optional": true },
    "@internationalized/date": { "optional": true },
    "motion": { "optional": true },
    "react-hook-form": { "optional": true },
    "three": { "optional": true },
    "@react-three/fiber": { "optional": true },
    "@react-three/drei": { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@changesets/cli": "3.0.3",
    "@internationalized/date": "3.12.4",
    "@microsoft/api-extractor": "7.59.4",
    "@playwright/test": "1.63.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/addon-docs": "9.1.20",
    "@storybook/react-vite": "9.1.20",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.1",
    "babel-jest": "30.5.2",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.5.2",
    "motion": "12.43.0",
    "picomatch": "4.0.7",
    "pixelmatch": "8.0.0",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "storybook": "9.1.20",
    "style-dictionary": "4.4.0",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "yaml": "2.9.1"
  }
}
