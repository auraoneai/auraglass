{
  "name": "aura-glass",
  "version": "5.0.0-alpha.0",
  "description": "AuraGlass 5.0 — the liquid-glass design system for React 19.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auraoneai/auraglass.git"
  },
  "bugs": {
    "url": "https://github.com/auraoneai/auraglass/issues"
  },
  "homepage": "https://auraglass.auraone.ai",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "files": [
    "dist",
    "deprecations.json",
    "llms.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js",
      "css": "./dist/styles.css"
    },
    "./material": {
      "types": "./dist/material/index.d.ts",
      "default": "./dist/material/index.js",
      "css": "./dist/material.css"
    },
    "./theme": {
      "types": "./dist/theme/public.d.ts",
      "default": "./dist/theme/public.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js",
      "css": "./dist/tokens.css"
    },
    "./motion": {
      "types": "./dist/motion/public.d.ts",
      "default": "./dist/motion/public.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./app-shell": {
      "types": "./dist/app-shell/index.d.ts",
      "default": "./dist/app-shell/index.js",
      "css": "./dist/app-shell.css"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js",
      "css": "./dist/data.css"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "default": "./dist/date/index.js",
      "css": "./dist/date.css"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js",
      "css": "./dist/ai.css"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js",
      "css": "./dist/media.css"
    },
    "./backdrops": {
      "types": "./dist/backdrops/index.d.ts",
      "default": "./dist/backdrops/index.js",
      "css": "./dist/backdrops.css"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "default": "./dist/compat/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./material.css": "./dist/material.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./compat/tokens.css": "./dist/compat/tokens.css",
    "./compat/globals.css": "./dist/compat/globals.css",
    "./deprecations.json": "./deprecations.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens:build": "node scripts/tokens/build.mjs",
    "prebuild": "node scripts/mat/build-prepaint-script.mjs",
    "build": "npm run tokens:build && tsdown",
    "postbuild": "node scripts/build/post.mjs",
    "dev": "tsdown --watch",
    "api:update": "node scripts/build/api-report.mjs",
    "pack:verify": "node scripts/ci/verify-pack.js",
    "prepublishOnly": "node scripts/ci/require-ci-publish.js",
    "artifact:publint": "publint",
    "artifact:attw": "attw --pack .",
    "storybook:build": "storybook build -o storybook-static",
    "docs:build": "node -e \"const f=require('fs').readdirSync('.artifacts/pack').find(x=>/^aura-glass-.*\\.tgz$/.test(x));if(!f){console.error('PENDING: run plat:package:pack first (.artifacts/pack/aura-glass-*.tgz missing)');process.exit(1)}console.log(f)\" && npm install --no-save -w apps/docs $(ls .artifacts/pack/aura-glass-*.tgz) && npm run build -w apps/docs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:contract": "npm test -- tests/contract",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:tokens:exports": "node --test tests/tokens/export.spec.mjs",
    "artifact:size-budgets": "node scripts/ci/verify-size-budgets.mjs",
    "artifact:deps": "node scripts/ci/verify-deps.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.4",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "react-aria-components": {
      "optional": true
    },
    "@internationalized/date": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "d3-scale": {
      "optional": true
    },
    "d3-shape": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "1.0.29",
    "@ai-sdk/react": "2.0.29",
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@changesets/cli": "3.0.3",
    "@internationalized/date": "3.12.4",
    "@microsoft/api-extractor": "7.59.4",
    "@playwright/test": "1.63.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/addon-docs": "9.1.20",
    "@storybook/react-vite": "9.1.20",
    "@tailwindcss/node": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.1",
    "ai": "5.0.29",
    "babel-jest": "30.5.2",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.5.2",
    "motion": "12.43.0",
    "picomatch": "4.0.7",
    "pixelmatch": "8.0.0",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "storybook": "9.1.20",
    "style-dictionary": "4.4.0",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "yaml": "2.9.1"
  }
}
