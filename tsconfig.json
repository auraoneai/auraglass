{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "aura-glass": ["./src/index.ts"],
      "aura-glass/*": ["./src/*/index.ts", "./src/*"]
    }
  },
  "include": ["src", "tests", "fragments", "registry", "showcase", "certification", "stories", ".storybook"],
  "exclude": ["fragments/codemods/*/fixtures", "tests/dx/fixtures/recipes-4x", "legacy", "dist", "node_modules", "packages/*/dist", "apps/docs/.next"]
}
