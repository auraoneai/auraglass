{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ui.shadcn.com/schema/registry-item.json",
  "title": "Registry Item (vendored shadcn v4 + meta.auraglass)",
  "type": "object",
  "required": ["name", "type", "files"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "type": {
      "type": "string",
      "enum": [
        "registry:base",
        "registry:block",
        "registry:item",
        "registry:component",
        "registry:ui",
        "registry:page",
        "registry:file",
        "registry:style",
        "registry:theme",
        "registry:lib",
        "registry:hook",
        "registry:example",
        "registry:internal"
      ]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "devDependencies": { "type": "array", "items": { "type": "string" } },
    "registryDependencies": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "target": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "cssVars": {
      "type": "object",
      "properties": {
        "theme": { "type": "object", "additionalProperties": { "type": "string" } },
        "light": { "type": "object", "additionalProperties": { "type": "string" } },
        "dark": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "css": { "type": "string" },
    "envVars": { "type": "object", "additionalProperties": { "type": "string" } },
    "docs": { "type": "string" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "meta": {
      "type": "object",
      "properties": {
        "auraglass": {
          "type": "object",
          "required": ["owner", "surface", "client", "components"],
          "additionalProperties": false,
          "properties": {
            "owner": { "type": "string", "enum": ["PLAT", "CMP", "SURF"] },
            "surface": { "type": "string", "enum": ["base", "block", "item"] },
            "client": { "type": "boolean" },
            "components": { "type": "array", "items": { "type": "string" } },
            "ga": { "type": "boolean" },
            "minVersion": { "type": "string" },
            "certified": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
            "replaces": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
