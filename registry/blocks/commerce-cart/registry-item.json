{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "commerce-cart",
  "type": "registry:block",
  "title": "Commerce cart",
  "description": "Controlled cart UI — line items, quantity steppers, localized totals.",
  "dependencies": [
    "react"
  ],
  "registryDependencies": [
    "auraglass"
  ],
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:block"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    },
    {
      "path": "CartSummary.tsx",
      "type": "registry:component"
    },
    {
      "path": "LineItem.tsx",
      "type": "registry:component"
    },
    {
      "path": "ProductCard.tsx",
      "type": "registry:component"
    },
    {
      "path": "format-money.ts",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "block",
      "client": false,
      "components": [
        "Badge",
        "Button",
        "Card",
        "Separator"
      ],
      "ga": false,
      "minVersion": "5.0.0"
    }
  }
}
