{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "ai-workspace",
  "type": "registry:block",
  "title": "AI workspace",
  "description": "Thread + Composer + UsageMeter + ProviderErrorState via useAuraChat; Next.js chat route on Kiro Prism (PRISM_* env). The route has no auth: add authentication/authorisation before exposure (README).",
  "dependencies": [
    "@ai-sdk/openai-compatible",
    "ai",
    "react"
  ],
  "registryDependencies": [
    "ai-artifact-panel",
    "ai-sdk-adapter",
    "auraglass"
  ],
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:block"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    },
    {
      "path": "page.tsx",
      "type": "registry:page",
      "target": "app/ai-workspace/page.tsx"
    },
    {
      "path": "replay-transport.ts",
      "type": "registry:lib"
    },
    {
      "path": "app/api/chat/route.ts",
      "type": "registry:file",
      "target": "app/api/chat/route.ts"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "block",
      "client": true,
      "components": [
        "AgentSteps",
        "AppShell",
        "Composer",
        "Inspector",
        "ProviderErrorState",
        "Thread",
        "TopBar",
        "UsageMeter"
      ],
      "ga": true,
      "minVersion": "5.0.0",
      "certified": null
    }
  }
}
