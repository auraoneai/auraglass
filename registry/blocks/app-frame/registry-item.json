{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "app-frame",
  "type": "registry:block",
  "title": "App frame",
  "description": "The GA application frame — AppShell with sidebar navigation, top bar, status bar and a docked inspector.",
  "dependencies": [
    "react"
  ],
  "registryDependencies": [
    "auraglass"
  ],
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:block"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "block",
      "client": false,
      "components": [
        "AppShell",
        "Inspector",
        "Sidebar",
        "StatusBar",
        "TopBar"
      ],
      "ga": true,
      "minVersion": "5.0.0",
      "certified": null
    }
  }
}
