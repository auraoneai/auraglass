{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "commerce-checkout",
  "type": "registry:block",
  "title": "Commerce checkout",
  "description": "Step-gated checkout: CMP Form steps (shipping, payment, review) and a step indicator with exactly one aria-current step that collapses to 'Step n of m' + Sheet below 768 px.",
  "dependencies": [
    "react",
    "aura-glass"
  ],
  "registryDependencies": [
    "auraglass",
    "commerce-cart"
  ],
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:block"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    },
    {
      "path": "CheckoutSteps.tsx",
      "type": "registry:component"
    },
    {
      "path": "steps.ts",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "block",
      "client": true,
      "components": [
        "Button",
        "Card",
        "Form",
        "Separator",
        "Sheet",
        "TextField",
        "VisuallyHidden"
      ],
      "ga": false,
      "minVersion": "5.0.0"
    }
  }
}
