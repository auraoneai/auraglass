{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "mobile-settings",
  "type": "registry:block",
  "title": "Mobile settings",
  "description": "MobileShell with a bottom TabBar and a CMP Sheet that opens GlassPreferencesPanel — 44×44 primary controls, one-hand reachable.",
  "dependencies": [
    "react",
    "aura-glass"
  ],
  "registryDependencies": [
    "auraglass"
  ],
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:block"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    },
    {
      "path": "mobile-settings.css",
      "type": "registry:style"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "block",
      "client": true,
      "components": [
        "GlassPreferencesPanel",
        "MobileShell",
        "Sheet",
        "TabBar"
      ],
      "ga": true,
      "minVersion": "5.0.0"
    }
  }
}
