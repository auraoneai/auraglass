{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "ai-eval-dashboard",
  "type": "registry:item",
  "title": "AI eval dashboard",
  "description": "Eval run summary — pass rate, per-case scores, token usage on UsageMeter.",
  "dependencies": [
    "react"
  ],
  "registryDependencies": [
    "auraglass"
  ],
  "files": [
    {
      "path": "EvalDashboard.tsx",
      "type": "registry:item"
    },
    {
      "path": "index.tsx",
      "type": "registry:item"
    },
    {
      "path": "fixtures/runs.json",
      "type": "registry:item"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "item",
      "client": true,
      "components": [
        "StatCard",
        "Table",
        "UsageMeter"
      ],
      "ga": true,
      "minVersion": "5.0.0"
    }
  }
}
