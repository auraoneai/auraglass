{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "media-audio-player",
  "type": "registry:item",
  "title": "Audio player",
  "description": "Consumer-owned <audio> + useMediaElement + MediaControls (play, scrubber, time, volume, rate).",
  "dependencies": [
    "react",
    "aura-glass"
  ],
  "registryDependencies": [
    "auraglass"
  ],
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:item"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "item",
      "client": true,
      "components": [
        "MediaControls"
      ],
      "ga": true,
      "minVersion": "5.0.0"
    }
  }
}
