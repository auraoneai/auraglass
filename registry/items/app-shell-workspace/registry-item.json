{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "app-shell-workspace",
  "type": "registry:item",
  "title": "App shell workspace",
  "description": "The archived 'workspace' block as an item \u2014 AppShell + page-header tabs + resizable panels + inspector with .ag-app-shell__auto-grid content.",
  "dependencies": [
    "react"
  ],
  "registryDependencies": [
    "auraglass"
  ],
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:item"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "item",
      "client": false,
      "components": [
        "AppShell",
        "Card",
        "Inspector",
        "ResizablePanels",
        "Sidebar",
        "Tabs",
        "Timeline",
        "TopBar"
      ],
      "ga": true,
      "minVersion": "5.0.0"
    }
  }
}
