{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "media-gallery",
  "type": "registry:item",
  "title": "Media gallery",
  "description": "Thumbnail grid of ImageViewer.Trigger + the shared popup (counter, keys, zoom).",
  "dependencies": [
    "react",
    "aura-glass"
  ],
  "registryDependencies": [
    "auraglass"
  ],
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:item"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "item",
      "client": true,
      "components": [
        "ImageViewer"
      ],
      "ga": true,
      "minVersion": "5.0.0"
    }
  }
}
