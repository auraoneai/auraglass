{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "presence-stack",
  "type": "registry:item",
  "title": "Presence stack",
  "description": "List of present users (names as text) with id-hashed palette colours, +N overflow and a 3-avatar clamp below 390 px of container width.",
  "dependencies": [
    "react",
    "aura-glass"
  ],
  "registryDependencies": [
    "auraglass"
  ],
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:item"
    },
    {
      "path": "fixtures.ts",
      "type": "registry:item"
    },
    {
      "path": "PresenceStack.tsx",
      "type": "registry:component"
    },
    {
      "path": "presence-stack.css",
      "type": "registry:style"
    }
  ],
  "meta": {
    "auraglass": {
      "owner": "SURF",
      "surface": "item",
      "client": false,
      "components": [
        "Avatar",
        "VisuallyHidden"
      ],
      "ga": true,
      "minVersion": "5.0.0"
    }
  }
}
