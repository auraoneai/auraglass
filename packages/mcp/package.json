{
  "name": "@auraglass/mcp",
  "version": "0.1.0",
  "description": "AuraGlass MCP server: read-only bundled docs/registry data over stdio.",
  "type": "module",
  "bin": {
    "auraglass-mcp": "./dist/server.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "data"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.24"
  },
  "license": "MIT",
  "private": false,
  "exports": {
    "./data/mcp-data.json": "./data/mcp-data.json"
  },
  "scripts": {
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node --permission --allow-fs-read=./data node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
