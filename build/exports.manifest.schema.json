{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "exports.manifest.schema.json",
 "title": "ExportsManifest",
 "type": "object",
 "required": [
  "version",
  "entries"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "subpath",
     "source"
    ],
    "properties": {
     "subpath": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "types": {
      "type": "string"
     },
     "default": {
      "type": "string"
     },
     "css": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}
