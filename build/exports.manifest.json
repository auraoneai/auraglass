    {
      "subpath": "./icons/status",
      "source": "src/icons/status.ts",
      "types": "dist/icons/status.d.ts",
      "default": "dist/icons/status.js"
    },
    {
      "subpath": "./icons/*",
      "source": "build:icon-glob",
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    }
  ]
}
