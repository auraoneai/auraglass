      "css": "dist/material.css"
    },
    {
      "subpath": "./theme",
      "source": "src/theme/public.ts",
      "types": "dist/theme/public.d.ts",
      "default": "dist/theme/public.js"
    },
    {
      "subpath": "./tokens",
      "source": "src/tokens/index.ts",
      "types": "dist/tokens/index.d.ts",
      "default": "dist/tokens/index.js",
      "css": "dist/tokens.css"
    },
    {
      "subpath": "./motion",
      "source": "src/motion/public.ts",
      "types": "dist/motion/public.d.ts",
      "default": "dist/motion/public.js"
