    {
      "subpath": "./styles.css",
      "source": "build:css",
      "default": "dist/styles.css",
      "css": "dist/styles.css"
    },
    {
      "subpath": "./tokens.css",
      "source": "build:css",
      "default": "dist/tokens.css",
      "css": "dist/tokens.css"
    },
    {
      "subpath": "./material.css",
      "source": "build:css",
      "default": "dist/material.css",
      "css": "dist/material.css"
    },
    {
      "subpath": "./tailwind.css",
      "source": "build:css",
      "default": "dist/tailwind.css",
