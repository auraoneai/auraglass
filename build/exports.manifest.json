      "default": "package.json"
    },
    {
      "subpath": "./icons/action",
      "source": "src/icons/action.ts",
      "types": "dist/icons/action.d.ts",
      "default": "dist/icons/action.js"
    },
    {
      "subpath": "./icons/ai",
      "source": "src/icons/ai.ts",
      "types": "dist/icons/ai.d.ts",
      "default": "dist/icons/ai.js"
    },
    {
      "subpath": "./icons/collaboration",
      "source": "src/icons/collaboration.ts",
      "types": "dist/icons/collaboration.d.ts",
      "default": "dist/icons/collaboration.js"
    },
    {
      "subpath": "./icons/commerce",
      "source": "src/icons/commerce.ts",
      "types": "dist/icons/commerce.d.ts",
      "default": "dist/icons/commerce.js"
    },
    {
      "subpath": "./icons/data",
      "source": "src/icons/data.ts",
      "types": "dist/icons/data.d.ts",
      "default": "dist/icons/data.js"
    },
    {
      "subpath": "./icons/media",
      "source": "src/icons/media.ts",
      "types": "dist/icons/media.d.ts",
      "default": "dist/icons/media.js"
    },
    {
      "subpath": "./icons/navigation",
