{
  "$schema": "./exports.manifest.schema.json",
  "version": 1,
  "entries": [
    {
      "subpath": ".",
      "source": "src/index.ts",
      "types": "dist/index.d.ts",
      "default": "dist/index.js",
      "css": "dist/styles.css"
    },
    {
      "subpath": "./material",
      "source": "src/material/index.ts",
