{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.shadcn.com/schema/registry-item.json",
  "title": "shadcn registry-item (vendored subset used by SURF blocks-lint)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "type", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": {
      "type": "string",
      "enum": [
        "registry:block", "registry:item", "registry:component", "registry:lib",
        "registry:hook", "registry:ui", "registry:page", "registry:file",
        "registry:theme", "registry:style"
      ]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "devDependencies": { "type": "array", "items": { "type": "string" } },
    "registryDependencies": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type"],
        "properties": {
          "path": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "registry:block", "registry:item", "registry:component", "registry:lib",
              "registry:hook", "registry:ui", "registry:page", "registry:file",
              "registry:theme", "registry:style"
            ]
          },
          "target": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "tailwind": { "type": "object" },
    "cssVars": { "type": "object" },
    "css": { "type": "object" },
    "meta": { "type": "object" },
    "docs": { "type": "string" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "extends": { "type": "string" }
  }
}
