{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sr-record.schema.json",
  "title": "Screen-reader manual test record",
  "type": "object",
  "required": ["sha", "cell", "at", "atVersion", "browser", "browserVersion", "os", "osVersion", "tester", "date", "component", "steps"],
  "properties": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "cell": { "type": "string", "enum": ["SR-1", "SR-2", "SR-3", "SR-4", "SR-5", "SR-6"] },
    "at": { "type": "string", "enum": ["VoiceOver", "NVDA", "JAWS", "TalkBack", "Narrator"] },
    "atVersion": { "type": "string", "minLength": 1 },
    "browser": { "type": "string", "minLength": 1 },
    "browserVersion": { "type": "string", "minLength": 1 },
    "os": { "type": "string", "minLength": 1 },
    "osVersion": { "type": "string", "minLength": 1 },
    "device": { "type": "string" },
    "tester": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "component": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nameRoleValue", "stateChange", "openClose", "liveRegion", "pass"],
        "properties": {
          "nameRoleValue": { "type": "string" },
          "stateChange": { "type": "string" },
          "openClose": { "type": "string" },
          "liveRegion": { "type": "string" },
          "gesture": { "type": "string" },
          "nonDragAlternative": { "type": "string" },
          "pass": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "cell": { "enum": ["SR-2", "SR-4"] } } },
      "then": { "required": ["device"] }
    }
  ],
  "additionalProperties": false
}
