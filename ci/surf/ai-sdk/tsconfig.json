{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "aura-glass/ai": ["../../../src/ai/index.ts"],
      "aura-glass/ai/*": ["../../../src/ai/*"],
      "aura-glass/*": ["../../../src/*"]
    }
  },
  "include": ["./**/*"]
}
