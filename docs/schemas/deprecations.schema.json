{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deprecations.schema.json",
  "title": "DeprecationEntry (S-38)",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "entry",
          "symbol",
          "since",
          "removeIn",
          "replacement",
          "codemod",
          "automation",
          "breaking",
          "message",
          "doc"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEP-[PMCSQ]\\d+$"
          },
          "kind": {
            "enum": [
              "asset",
              "behavior",
              "cli",
              "css-global",
              "css-var",
              "data-attr",
              "dependency",
              "engine",
              "export",
              "peer",
              "prop",
              "prop-value",
              "subpath"
            ]
          },
          "status": {
            "anyOf": [
              {
                "const": "active"
              },
              {
                "const": "planned"
              }
            ]
          },
          "entry": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "since": {
            "type": "string",
            "pattern": "^4\\.\\d+\\.\\d+$"
          },
          "removeIn": {
            "anyOf": [
              {
                "const": "5.0.0"
              },
              {
                "const": "6.0.0"
              }
            ]
          },
          "replacement": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "codemod": {
            "anyOf": [
              {
                "enum": [
                  "ai-chat",
                  "app-shell-slots",
                  "canonical-names",
                  "css-vars",
                  "dead-optical-props",
                  "deps",
                  "imports-subpaths",
                  "media-backdrops",
                  "motion-imports",
                  "motion-props",
                  "prop-grammar",
                  "providers",
                  "reduced-motion-initial",
                  "removed"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "automation": {
            "anyOf": [
              {
                "const": "full"
              },
              {
                "const": "mostly"
              },
              {
                "const": "partial"
              },
              {
                "const": "manual"
              },
              {
                "const": "none"
              }
            ]
          },
          "breaking": {
            "type": "string",
            "pattern": "^B\\d+$"
          },
          "message": {
            "type": "string"
          },
          "doc": {
            "type": "string",
            "pattern": "^#dep-.*$"
          },
          "compat": {
            "type": "string"
          },
          "exception": {
            "anyOf": [
              {
                "const": "security"
              },
              {
                "const": "privacy"
              },
              {
                "const": "crash"
              },
              {
                "const": "legal"
              },
              {
                "const": "honesty"
              }
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
