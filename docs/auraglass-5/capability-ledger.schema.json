{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auraglass.dev/schemas/capability-ledger.schema.json",
  "title": "AuraGlass capability ledger (REQ-SURF-179)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "rows"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "enum": ["1"] },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "capability", "area", "priority", "owner", "collaborators",
          "form", "names", "release", "evidence", "findings", "reqRefs",
          "rubric", "exportDelta", "status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^X-(R)?[0-9]{2}$" },
          "capability": { "type": "string" },
          "area": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "owner": { "type": "string", "enum": ["PLAT", "MAT", "CMP", "SURF", "QUAL"] },
          "collaborators": {
            "type": "array",
            "items": { "type": "string", "enum": ["PLAT", "MAT", "CMP", "SURF", "QUAL"] }
          },
          "form": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["export", "part", "prop", "registry-item", "registry-block", "labs", "rejected"]
            }
          },
          "names": { "type": "array", "items": { "type": "string" } },
          "subpath": { "type": "string", "pattern": "^\\.(/.+)?$" },
          "release": { "type": "string", "pattern": "^(5\\.[0-9x]+|never)$" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(research/competitors\\.md:[0-9]+|exception:.+)$"
            }
          },
          "findings": { "type": "array", "items": { "type": "string" } },
          "reqRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[A-Z0-9]+-[0-9]+$" }
          },
          "rubric": {
            "type": "object",
            "additionalProperties": false,
            "required": ["r1", "r2", "r3", "r4", "r5", "r6"],
            "properties": {
              "r1": { "type": "boolean" },
              "r2": { "type": "boolean" },
              "r3": { "type": "boolean" },
              "r4": { "type": "boolean" },
              "r5": { "type": "boolean" },
              "r6": { "type": "boolean" }
            }
          },
          "exportDelta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "subpath"],
            "properties": {
              "root": { "type": "integer" },
              "subpath": { "type": "integer" }
            }
          },
          "budgetKb": { "type": "integer" },
          "status": { "type": "string", "enum": ["planned", "delivered", "deferred", "rejected"] },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "demand": { "type": "array", "items": { "type": "string" } },
          "stories": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
